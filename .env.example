# Настройки бэкенда. Скопируйте в .env (локально) или .env.prod (на сервере) и заполните.
# Файлы .env* в репозиторий не попадают. Переменные окружения важнее значений из файла.

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

DB_NAME=tazalyk
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ---- только на сервере ----
# HTTPS: перенаправление, защищённые куки, HSTS
DJANGO_HTTPS=True
# Сколько прокси стоит перед Django. Без этого лимиты считались бы по адресу nginx — один на всех
DRF_NUM_PROXIES=1
PUBLIC_MEDIA_BASE_URL=https://api.mptazalyk.kg

# ---- только локально ----
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://localhost:5173

# ---- магазин ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=
SHOP_TELEGRAM_USERNAME=
# Номер менеджера для кнопки WhatsApp, например 996555123456
SHOP_WHATSAPP_PHONE=
# Отдельный чат для оповещений о подборе паролей
TELEGRAM_ALERTS_CHAT_ID=

# ---- пароли для create_users.py: только при первом создании сотрудников ----
ADMIN_PASSWORD=
CONTENT_MANAGER_PASSWORD=
PROCUREMENT_MANAGER_PASSWORD=
LEGAL_MANAGER_PASSWORD=
VIEWER_PASSWORD=
